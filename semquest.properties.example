# ============================================================
#  问义树 SemQuestTree 配置模板
#  复制本文件为 semquest.properties 再填值（真实凭据文件已被 .gitignore 排除，不入库）
#  优先级：JVM 系统属性(-Dsemquest.KEY=...) > 本文件 > 代码内默认
# ============================================================

# 决策后端: mock | jev | openrouter | bailian
# mock = 零凭据确定性后端（纯关键词匹配，仅供体验 / 演示 / 测试，零 token）
# 决策模型 API key 目前支持两家：jev 与 OpenRouter，自行申请后填到下方对应 apikey；
# 百炼暂未开放决策模型，待其上线后再适配
backend=mock

# noul 门控（P(yes) >= noulGate 视为通过）；choice 表用 choiceGate 采纳线。
# 两者热载：保存即应用到对应模式的全部表
noulGate=0.7
choiceGate=0.6

# 查询结果缓存容量（条）：同一条查询原文再次检索零模型直返（noul/choice 均生效），
# 按命中次数排序淘汰（调用最多最不易淘汰）；0=关闭；热载，仅内存不落盘
questCacheSize=256

# ── 数据驱动生长：add 落兜底同步长新枝（默认关闭；热载）──────────────────
# add/addBatch 落位全为兜底叶（或空树根叶）= 树里没有能承接这条内容的类别，
# 同步调生成模型按本条内容产出 ≤growth.maxNew 个新分支（名字+判据）逐个验收：
# 入树后从重判结果看本条是否收编，未收编 undoGrow 原位回滚不丢数据；全部失败本条保留在兜底叶。
# 收编的分支记入 grown 回放（auto 标记），重启零模型恢复，可用节点删除撤销。
# 注意：生长在表锁内同步执行，生成期间该表其他请求排队；quest 检索纯读不改树（查不到就是查不到）。
growth.enabled=false
# 生成模型（openrouter chat completions 端点，apikey 复用 openrouter.apikey）
# 默认款为免费中文模型，生成零成本；免费款上下线是常态，不可用时在上游换 ⚡·免费 的
growth.model=xingchen-agi/xing4.0-29b-a4b:free
# 生长生成模型手动清单（逗号分隔；配置即清单优先生效，保存即热载；留空回上游实时拉取；
# 运行时也可在可视化页头部 🌱 开关与下拉框热改，重启回这里的配置值）
growth.models=
# 端点覆盖（可选，默认 https://openrouter.ai/api/v1/chat/completions）
#growth.url=https://openrouter.ai/api/v1/chat/completions
# 护栏：同一父层分支数达到此值后不再生长（防无限膨胀）；热载
growth.maxBranches=12
# 单次生长最多提出的新分支数；热载
growth.maxNew=2
# 生成提速护栏（均热载；不配 = 请求体不带该字段，行为与旧版逐字一致）：落兜底那一次生成占 add 总耗时九成以上，
# 而耗时几乎正比于输出 token 数——思考型模型的思维链常占输出九成（实测 qwen3.7-flash 出 3066 token / 38.6s）。
# growth.maxTokens：单次生成输出上限（含思维链），0/留空 = 不发；被截断时 growthStep.failed 会提示调大。
# growth.thinking：OpenRouter 统一推理力度 none/low/medium/high，留空 = 不发（沿用模型默认）。
# 实测取向：none 只出 JSON 正文，约 3~6s；low 判据更厚，约 8~13s。
#growth.thinking=none
#growth.maxTokens=1024
# 生成提示词模板（热载；完整模板见 semquest.properties 的 growth.prompt 显式示例，
# 判据语义=类别含义：名词式列举该类覆盖的主题/维度；留空回代码内置默认，两者语义一致）
# 占位符：{parent}=层节点名、{siblings}=现有分支清单、{count}/{samples}=落兜底内容、{maxNew}=上限（\n=换行）
#growth.prompt=你在维护一棵判据树（用自然语言判据给内容分类）。层「{parent}」现有分支：\n{siblings}以下 {count} 条内容落入了兜底（现有分支都不覆盖）：\n{samples}提出至多 {maxNew} 个新分支让这类内容有家可归。要求：\n- 名字是一个类别词（不超过 6 个字）；yes 写这个类别的含义——它覆盖哪些主题或维度，用名词短语列举（示例：类别「职业身份」的 yes 写「工作地域，工作内容」这样的含义列举，不要写成「内容聚焦于……」那种描述什么话会进来的句子）；\n- 含义须与现有分支互斥不重叠；若现有分支已能覆盖这些内容，branches 返回空数组。\n只输出 JSON 对象：{"branches":[{"name":"…","yes":"…"}]}

# ── 节点延伸（深度生长）：叶存量超水位 → 后台串行拆细该节点（不阻塞 add/quest）──
# 触发双通道：① 水位自动（add 落位后检查）② viz 右键手动触发；false 关闭（生长总开关也须开）
#growth.extend=true
# 水位 = growth.splitAt × growth.splitFactor（例 255×0.7=178 条）；≤0 关闭水位触发
#growth.splitAt=255
#growth.splitFactor=0.7
# 单次延伸最多长出的子类数；给生成器看的存量样本条数
#growth.extend.maxNew=8
#growth.extend.samples=40
# 延伸生成提示词模板（层级无关：不写死「第几层」，只约束「比父节点细一层」，任意深度递复用）
# 占位符：{parent}={parentYes}={count}={siblings}（每轮最新）={samples}；完整模板见 semquest.properties 的 growth.extend.prompt
#growth.extend.prompt=你在维护一棵判据树（用自然语言判据给内容分类）。节点「{parent}」（含义：{parentYes}）下已积累 {count} 条内容，太拥挤了，需要向下延伸出更细的子类。\n\n它现有的子分支（可能为空，已互斥不重叠）：\n{siblings}\n该节点下的内容样本：\n{samples}提出 1 个新子分支，把这批内容进一步细分。要求：\n- 子类比「{parent}」细一层：{parentYes} 是它们的公共上限，子类只覆盖其中一块——不能与父类同粒度，也不能与现有子分支重叠；\n- 优先挑内容样本里占比最大、内部又相似的一簇，让最多的内容有子类可归；\n- 名字是一个类别词（不超过 6 个字）；yes 写这个子类的含义——它在父类基础上再往哪个具体方向收，用名词短语列举（示例：父类「职业身份」含义「工作地域，工作内容」，其子类「技术研发」的 yes 写「工程师，架构师，算法研究员」这样更细的岗位列举，不要写成「内容聚焦于……」那种句子）；\n- 若现有子分支已能覆盖这些内容，或内容之间找不到更细的共同侧面，branches 返回空数组。\n只输出 JSON 对象：{"branches":[{"name":"…","yes":"…"}]}

# ── 判定提示词（系统侧组装文案；判据 yes/no 与规则文本归树，不在这里）──
# 热载：保存即应用到全部表，同时清空各表查询缓存
# 占位符：{name}=分支名、{node}=层节点名、{yes}=判据原文；删行或留空=内置默认
# noul instructions 仅 jev / respan 方言下发；openrouter（非 respan）与百炼下发的是判据文本（含 criterion 包裹）
# 规则（state.rule；新表默认值，热载置换仍为默认文本的表，已自定义的不动）
# 语义分野：add 的判据=类别含义（内容是否属此类）；search 的判据=关联性（查询与该类内容的相关程度，不做归类）
prompt.rule.add=判断输入内容与哪个分支的类别含义相符。
prompt.rule.search=判断该查询的问题或陈述与哪个分支下的内容关联性最大。
# noul instructions（questions{name}.instructions；{name}=分支名）
prompt.noul.add.instructions={name}
# 落位判据包裹（判据=类别含义，落位侧把含义转成判定任务；留空/删行=恒等 {yes} 旧行为；choice 落位不套用）
#prompt.noul.add.criterion=判断输入内容是否属于「{name}」这一类——该类含义：{yes}。属于 true，不属于 false。
# 检索判据包裹（判定前对判据文本套模板；{yes}=判据原文、{name}=分支名）
# 落位侧恒等 {yes}（写死，无配置键）：判据=类别含义，模型按「内容是否属此类」判；
# 检索侧默认包关联性框架，判「该查询的问题或陈述与该类内容的关联性是否够大」——不做归类，
# 问句式查询（如「我在哪里工作」）靠它接住；noul 题目与 choice 选项共用（choice 检索的选项描述也套本框架）
prompt.noul.search.criterion=该查询与「{name}」这类内容（含义：{yes}）的关联性是否足够大？足够大才 true
# choice 问句（questions.q.instructions；{node}=层节点名，ROOT 层用 root 键）
prompt.choice.add.root=这句话最符合哪一类？
prompt.choice.add.node={node}
# choice 兜底选项描述（criteria[X_OTHER]）
prompt.choice.other=以上都不符合

# 检索请求包裹（{query}=查询原文；noul 与 choice 检索共用）：给上面判据检索框架里的
# 「该查询」提供指代源，使「所有悲伤的话」这类元描述查询不被当成内容本身判定；配 {query} 即恒等退回裸查询
prompt.noul.search.query=用户的问题或陈述：{query}

# 可选分野键：检索侧用不同文案时才配，删行或留空即继承 add 侧同键
#prompt.noul.search.instructions={name}
#prompt.choice.search.root=这句话最符合哪一类？
#prompt.choice.search.node={node}

# 预制层级分支 schema（类似建表的字段声明）
schema=driver-intent-schema.json

# 单请求超时（毫秒）
timeoutMs=30000

# ── jev（TypeSafe SystemOne，主传感器）─────────────────────
jev.baseUrl=https://api.typesafe.ai
jev.model=jev-1.13.0
jev.apikey=your-jev-api-key

# ── OpenRouter ──────────────────────
openrouter.url=https://openrouter.ai/api/alpha/decisions
# 免费款上下线是常态，当前款不可用时在上游模型列表挑 ⚡·免费 的换上
openrouter.model=baseten/elephant-1:free
openrouter.apikey=your-openrouter-api-key

# ── 可视化服务（SemQuestServer）──────────────────────────
server.port=8787
server.data=tree-data.json
server.viz=viz.html

# ── 阿里云百炼 ──────────────────
# 百炼暂未开放决策模型，开放后再适配（先跑 mock / jev / openrouter）
# 端点因部署而异（含个人工作区 ID），请从控制台获取
bailian.url=your-bailian-endpoint-url
bailian.model=decision-model-preview
bailian.apikey=your-bailian-api-key

# ── 手动模型清单（逗号分隔；配置即清单优先生效，保存即热载；留空回上游实时拉取）──
jev.models=jev-1.13.0,jev-latest
openrouter.models=
bailian.models=decision-model-preview
