# ============================================================
#  问义树 SemQuestTree 配置模板
#  复制本文件为 semquest.properties 再填值（真实凭据文件已被 .gitignore 排除，不入库）
#  优先级：JVM 系统属性(-Dsemquest.KEY=...) > 本文件 > 代码内默认
# ============================================================

# 决策后端: mock | jev | openrouter | bailian
# mock = 零凭据确定性后端（纯关键词匹配，仅供体验 / 演示 / 测试，零 token）
# 决策模型 API key 目前支持两家：jev 与 OpenRouter，自行申请后填到下方对应 apikey；
# 百炼暂未开放决策模型，待其上线后再适配
backend=mock

# noul 门控（P(yes) >= noulGate 视为通过）；choice 表用 choiceGate 采纳线。
# 两者热载：保存即应用到对应模式的全部表
noulGate=0.7
choiceGate=0.6

# 查询结果缓存容量（条）：同一条查询原文再次检索零模型直返（noul/choice 均生效），
# 按命中次数排序淘汰（调用最多最不易淘汰）；0=关闭；热载，仅内存不落盘
questCacheSize=256

# ── 数据驱动生长：兜底缓冲批量生长（默认关闭；热载）──────────────────
# add/addBatch 落位全为兜底叶（或空树根叶）= 树里没有能承接这条内容的类别 → 落兜底即积压；
# 各层兜底积压 ≥ 阈值 → 提交后台维护任务批量生长（add 立即返回，不等待）：一次快照 ≤growth.samples
# 条积压样本调生成模型产出 ≤growth.maxNew 个新分支（名字+判据）逐个验收：
# 结构入树（零模型）→ 存量重判（过门迁入）→ 积压快照样本收编数 ≥ growth.acceptMin 保留
# （记 grown 回放 auto 标记），否则 undoGrow 原位回滚不丢数据；全部回滚该层冻结入失败记忆，
# 兜底样本换血过半自动解冻重试（下次生成携带上次失败证据，不再开盲盒）。
# quest 检索纯读不改树（查不到就是查不到）；生长与维护共用后台单工池，不阻塞 add/quest。
growth.enabled=false
# 生成模型（openrouter chat completions 端点，apikey 复用 openrouter.apikey）
# 默认款为免费中文模型，生成零成本；免费款上下线是常态，不可用时在上游换 ⚡·免费 的
growth.model=xingchen-agi/xing4.0-29b-a4b:free
# 生长生成模型手动清单（逗号分隔；配置即清单优先生效，保存即热载；留空回上游实时拉取；
# 运行时也可在可视化页头部 🌱 开关与下拉框热改，重启回这里的配置值）
growth.models=
# 端点覆盖（可选，默认 https://openrouter.ai/api/v1/chat/completions）
#growth.url=https://openrouter.ai/api/v1/chat/completions
# 护栏：同一父层分支数达到此值后不再生长（防无限膨胀）；热载
growth.maxBranches=12
# 单次生长最多提出的新分支数；热载
growth.maxNew=2
# 生成提速护栏（均热载；不配 = 请求体不带该字段，行为与旧版逐字一致）：落兜底那一次生成占 add 总耗时九成以上，
# 而耗时几乎正比于输出 token 数——思考型模型的思维链常占输出九成（实测 qwen3.7-flash 出 3066 token / 38.6s）。
# growth.maxTokens：单次生成输出上限（含思维链），0/留空 = 不发；被截断时 growthStep.failed 会提示调大。
# growth.thinking：OpenRouter 统一推理力度 none/low/medium/high，留空 = 不发（沿用模型默认）。
# 实测取向：none 只出 JSON 正文，约 3~6s；low 判据更厚，约 8~13s。
#growth.thinking=none
#growth.maxTokens=1024
# 落兜底生长提示词：growth.prompt = 提示词文件路径（相对进程工作目录或绝对路径），
# 文件内容即模板正文（UTF-8 纯文本；本项目在 prompts/ 目录一文件一提示词）
# 占位符：{parent}=层节点名、{siblings}=现有分支清单、{count}/{samples}=落兜底内容、{maxNew}=上限、{attempts}=历史尝试段（仅有失败记忆时注入，无失败零开销）
# 未配置/文件不可读/内容空白 → 生长步直接记 growthStep.failed（代码零内置模板，不给默认）
growth.prompt=prompts/growth-prompt.txt

# ── 树体代谢：维护任务（回收/体检/重写/批量生长四步循环；热载）──────────────────
# 后台单工维护任务每轮：①回收扫描（零收编且过保护期的枝摘除）②判据体检（轮转抽样诊断）
# ③重写验收（旧成员保住率门限，另奖励吸入层兜底同类存量）④兜底批量生长；
# 人工 editNode 过的分支体检只报告不自动重写。触发：各层兜底积压达阈值 / viz 手动「立即维护」；
# 单任务最多 growth.maintRounds 轮，收工自查有积压继续排队消化。
# growth.bufferMin：非根层兜底积压触发阈值（条）
# growth.bufferRoot：ROOT 层兜底积压触发阈值（条，首批骨架要一次长出来所以更大）
# growth.samples：一次生长生成器看到的积压样本条数（均匀抽样）
# growth.acceptMin：生长验收门限——积压快照样本收编数达此值才保留新枝
# growth.auditBatch：单轮体检的分支数上限（轮转队列，最近最久未体检优先）
# growth.recycleProtect：新枝出生保护期（全局轮数）——期间零收编也不回收
# growth.refineKeep：重写验收门限——旧成员保住率（0~1）低于此值提案回滚入失败记忆
# growth.maintRounds：单次维护任务的最大轮数
growth.bufferMin=5
growth.bufferRoot=30
growth.samples=20
growth.acceptMin=2
growth.auditBatch=8
growth.recycleProtect=3
growth.refineKeep=0.9
growth.maintRounds=4

# 体检提示词：growth.audit.prompt = 提示词文件路径（构造时可选读取，用到才报错——三种生成
# 提示词互不连坐：延伸任务不再连带要求 growth.prompt）。
# 占位符：{name}=分支名、{yes}=现判据、{siblings}=兄弟判据、{memberCount}/{members}=已收编成员、
#         {fallbackCount}/{fallback}=层兜底未承接、{attempts}=上次重写失败证据（无失败时不注入）
# 输出 {"branches":[]} = 健康；非空 = 重写提案（须保住全部现有成员）
growth.audit.prompt=prompts/audit-prompt.txt

# ── 节点延伸（深度生长）：叶存量超水位 → 后台串行拆细该节点（不阻塞 add/quest）──
# 触发双通道：① 水位自动（add 落位后检查）② viz 右键手动触发；false 关闭（生长总开关也须开）
#growth.extend=true
# 水位 = growth.splitAt × growth.splitFactor（例 10×1.0=10 条：叶存量软上限，超即拆细到下一层）；≤0 关闭水位触发
# 2026-11-17 起默认 10 条/叶（原 178）——叶子小则 doc 过滤单批可控、树更细
#growth.splitAt=10
#growth.splitFactor=1.0
# 单次延伸最多长出的子类数；给生成器看的存量样本条数
#growth.extend.maxNew=8
#growth.extend.samples=40
# 延伸生成提示词（层级无关：不写死「第几层」，只约束「比父节点细一层」，任意深度递复用）
# 占位符：{parent}={parentYes}={count}={siblings}（每轮最新）={samples}={attempts}（上次失败证据，无失败时不注入）；
# 未配置/空白 → 延伸任务报错终止
growth.extend.prompt=prompts/growth-extend-prompt.txt

# ── doc 级出检过滤（quest 命中叶后对叶内内容逐条判定相关性，滤掉与查询无关的返回；热载）──
# 「车」叶下落了自行车和火车：层判定只保证叶子相关，doc 过滤补齐判定链最后一环。
# 判据树「每一跳都可判定」到 doc 级补全；与叶子水位延伸互补——延伸把常见异质在结构上拆开，过滤兜住残留。
docFilter=true
# P(相关) 采纳线（独立于 noulGate：doc 相关性与层判定语义强度不同）
docFilterGate=0.6
# 单次打包判定条数（分批多次调用，单批 prompt 规模恒定）；百炼后端单请求 ≤16 题自动再拆
docFilter.batch=20
# 判据里 doc 原文截断上限（只求判定相关性，防长文撑爆单批）
docFilter.maxLen=200
# 单次 quest 待过滤 doc 总量上限（跨命中叶去重）：超过则响应 confirmRequired=true 返回未过滤结果，
# 由前端询问用户是否继续，确认后带 confirm=true 重发才执行——大花销必须过用户点头这道闸
docFilter.maxDocs=100
# doc 过滤判据包裹模板（{yes}=doc 原文截断后）；唯一可选提示词——未配置时 doc 过滤自动不生效（旧部署零影响）
prompt.docfilter.criterion=prompts/doc-filter-prompt.txt

# ── 判定提示词（系统侧组装文案；判据 yes/no 与规则文本归树，不在这里）──
# 键值 = 提示词文件路径（相对进程工作目录或绝对路径），文件内容即模板正文（UTF-8 纯文本，一文件一提示词）。
# 全部必配：键值缺失/文件不可读/内容空白 → 服务启动失败（代码零内置文本，不给任何默认回退）；
# 热载：保存即应用到全部表并清空查询缓存；热载时装载失败保留旧值。
# 占位符：{name}=分支名、{node}=层节点名、{yes}=判据原文、{query}=查询原文
# noul instructions 仅 jev / respan 方言下发；openrouter（非 respan）与百炼下发的是判据文本（含 criterion 包裹）
# 规则（state.rule；建表默认值；热载仅置换仍等于上次应用文本的表，已自定义的不动）
# 语义分野：add 的判据=类别含义（内容是否属此类）；search 的判据=关联性（查询与该类内容的相关程度，不做归类）
prompt.rule.add=prompts/rule-add.txt
prompt.rule.search=prompts/rule-search.txt
# noul instructions（questions{name}.instructions；{name}=分支名）
prompt.noul.add.instructions=prompts/noul-add-instructions.txt
# 落位判据包裹（判据=类别含义，落位侧把含义转成判定任务；choice 落位不套用）
prompt.noul.add.criterion=prompts/noul-add-criterion.txt
# 检索判据包裹（判定前对判据文本套模板；{yes}=判据原文、{name}=分支名）
# 落位侧恒等判据原文（无配置键）；检索侧包关联性框架——add 归类、search 求关联，两侧语义分野；
# 问句式查询（如「我在哪里工作」）靠框架接住；noul 题目与 choice 选项共用（choice 检索的选项描述也套本框架）
prompt.noul.search.criterion=prompts/noul-search-criterion.txt
# choice 问句（questions.q.instructions；{node}=层节点名，ROOT 层用 root 键）
prompt.choice.add.root=prompts/choice-add-root.txt
prompt.choice.add.node=prompts/choice-add-node.txt
# choice 兜底选项描述（criteria[X_OTHER]）
prompt.choice.other=prompts/choice-other.txt

# no 侧自动生成模板（节点未给 no 判据时由 NoulSpec.autoNo 生成；{yes}=判据原文，按判据语言自动选中/英模板）
prompt.noul.no.han=prompts/noul-no-han.txt
prompt.noul.no.latin=prompts/noul-no-latin.txt

# 检索请求包裹（{query}=查询原文；noul 与 choice 检索共用）：给上面判据检索框架里的
# 「该查询」提供指代源，使「所有悲伤的话」这类元描述查询不被当成内容本身判定
prompt.noul.search.query=prompts/noul-search-query.txt

# 可选分野键：检索侧用不同文案时才配，未配置即继承 add 侧同键（文件仍须可读）
#prompt.noul.search.instructions=prompts/noul-search-instructions.txt
#prompt.choice.search.root=prompts/choice-search-root.txt
#prompt.choice.search.node=prompts/choice-search-node.txt

# 预制层级分支 schema（类似建表的字段声明）
schema=driver-intent-schema.json

# 单请求超时（毫秒）
timeoutMs=30000

# ── jev（TypeSafe SystemOne，主传感器）─────────────────────
jev.baseUrl=https://api.typesafe.ai
jev.model=jev-1.13.0
jev.apikey=your-jev-api-key

# ── OpenRouter ──────────────────────
openrouter.url=https://openrouter.ai/api/alpha/decisions
# 免费款上下线是常态，当前款不可用时在上游模型列表挑 ⚡·免费 的换上
openrouter.model=baseten/elephant-1:free
openrouter.apikey=your-openrouter-api-key

# ── 可视化服务（SemQuestServer）──────────────────────────
server.port=8787
server.data=tree-data.json
server.viz=viz.html

# ── 阿里云百炼 ──────────────────
# 百炼暂未开放决策模型，开放后再适配（先跑 mock / jev / openrouter）
# 端点因部署而异（含个人工作区 ID），请从控制台获取
bailian.url=your-bailian-endpoint-url
bailian.model=decision-model-preview
bailian.apikey=your-bailian-api-key

# ── 手动模型清单（逗号分隔；配置即清单优先生效，保存即热载；留空回上游实时拉取）──
jev.models=jev-1.13.0,jev-latest
openrouter.models=
bailian.models=decision-model-preview
